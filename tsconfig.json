{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@core/*": ["core/*"],
      "@infrastructure/*": ["infrastructure/*"],
      "@shared/*": ["shared/*"]
    },

    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2020",

    "esModuleInterop": true,
    "strict": true,
    "isolatedModules": false,
    "skipLibCheck": true,
    "types": [
      "node",
      "express",
      "express-serve-static-core",
      "cors",
      "qs",
      "swagger-jsdoc",
      "swagger-ui-express",
      "jsonwebtoken"
    ],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/test-helpers/**"
  ]
}
