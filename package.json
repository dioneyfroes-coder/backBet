{
  "name": "backbet",
  "version": "1.0.0",
  "description": "backendBet",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "smoke": "npm run build && node scripts/smoke-api.cjs",
    "test:integration": "node scripts/run-integration-tests.cjs",
    "test:integration:full": "node scripts/run-integration-tests.cjs --with-infra",
    "test:integration:docker": "docker compose -f docker-compose.test.yml run --rm integration-tests",
    "test:load": "node scripts/run-integration-tests.cjs -- src/integration/__tests__/load.concurrency.integration.test.ts",
    "test:load:distributed": "node scripts/run-integration-tests.cjs -- src/integration/__tests__/load.distributed.integration.test.ts",
    "test:load:percentiles": "node scripts/percentile-driver.cjs",
    "test:crash": "node scripts/run-integration-tests.cjs -- src/integration/__tests__/crash.integration.test.ts",
    "test:multiworker": "node scripts/run-integration-tests.cjs -- src/integration/__tests__/multi-worker.integration.test.ts",
    "test:backup": "node scripts/run-integration-tests.cjs -- src/integration/__tests__/backup.integration.test.ts",
    "docker:rebuild": "bash scripts/docker-rebuild-drill.sh",
    "docker:rebuild:ci": "bash scripts/docker-rebuild-drill.sh --yes --down",
    "test:failure": "node scripts/run-integration-tests.cjs -- src/integration/__tests__/failure.integration.test.ts",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d --wait mongodb redis mongo-rs-init",
    "test:infra:down": "docker compose -f docker-compose.test.yml down",
    "test:infra:reset": "docker compose -f docker-compose.test.yml down -v && docker compose -f docker-compose.test.yml up -d --wait mongodb redis mongo-rs-init",
    "check": "npm run check:secrets && npm run lint && npm run test:coverage && npm run build",
    "check:secrets": "node scripts/check-secrets.cjs",
    "security:assess": "node scripts/security-assess.cjs",
    "audit": "npm audit",
    "audit:prod": "npm audit --omit=dev",
    "audit:prod:critical": "npm audit --omit=dev --audit-level=critical",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias && node scripts/copy-web-assets.cjs",
    "start": "node scripts/entry.cjs",
    "seed:credit-packages": "tsx src/scripts/seedCreditPackages.ts",
    "migration:run": "tsx src/scripts/runMigrations.ts",
    "seed:initial": "tsx src/scripts/seedInitialData.ts",
    "seed:treasury": "tsx src/scripts/seedHouseTreasury.ts",
    "backup:create": "tsx src/scripts/backup-mongo.ts",
    "backup:restore": "tsx src/scripts/restore-mongo.ts",
    "backup:validate": "tsx src/scripts/validate-backup.ts",
    "backup:drill": "tsx src/scripts/backup-drill.ts",
    "wallet:balance": "tsx src/scripts/getWalletBalance.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs --env development",
    "pm2:start:prod": "pm2 start ecosystem.config.cjs --env production --no-daemon",
    "pm2:start:with-worker": "npm run build && pm2 start ecosystem.with-worker.config.cjs --env production",
    "pm2:start:mailer": "npm run build && pm2 start ecosystem.mailer.config.cjs --env production",
    "pm2:full": "npm run build && [ -f ./dist/index.js ] || (echo \"dist not found. run 'npm run build'\" && exit 1) && pm2 start ecosystem.config.cjs ecosystem.mailer.config.cjs ecosystem.withdrawal.config.cjs --env production && npm run pm2:webui:start",
    "pm2:stop": "pm2 stop backbet",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env development",
    "pm2:logs": "pm2 logs backbet",
    "pm2:webui:start": "node scripts/pm2-webui-start.cjs",
    "pm2:webui:stop": "pm2 delete pm2-webui || true",
    "pm2:webui:status": "pm2 show pm2-webui",
    "pm2:webui:logs": "pm2 logs pm2-webui",
    "health-monitor:start": "node scripts/health-monitor.cjs",
    "pm2:health:start": "pm2 start scripts/health-monitor.cjs --name health-monitor",
    "pm2:health:stop": "pm2 delete health-monitor || true",
    "pm2:health:status": "pm2 show health-monitor",
    "pm2:health:logs": "pm2 logs health-monitor",
    "worker:contact": "tsx src/scripts/start-contact-worker.ts",
    "worker:withdrawal": "tsx src/scripts/start-withdrawal-worker.ts",
    "pm2:start:withdrawal": "npm run build && pm2 start ecosystem.withdrawal.config.cjs --env production",
    "pm2:kill": "bash ./scripts/pm2-kill.sh"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/express-serve-static-core": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^24.10.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/qs": "^6.9.15",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.8",
    "cors": "^2.8.5",
    "dotenv": "^16.1.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.3.0",
    "mongoose": "^8.0.3",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pm2": "^7.0.4",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsc-alias": "^1.8.10",
    "zod": "^4.1.12"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.8",
    "@types/nodemailer": "^6.4.7",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
