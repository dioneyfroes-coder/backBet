# =============================================================================
# BackBet — variáveis de ambiente (exemplo seguro)
#
# Uso local de desenvolvimento (neste PC):
#   cp .env.example .env
#
# Uso no servidor (Ubuntu + Docker Compose — TUDO em Docker no mesmo host):
#   cp .env.example .env   # preencha JWT_SECRET + senhas do MongoDB
#   docker compose up -d --build
#
# Regras:
#   - NUNCA versione este arquivo com valores reais (o .env real é .gitignore).
#   - Valores abaixo são EXEMPLOS SEGUROS. Troque obrigatoriamente os que são
#     marcados como OBRIGATÓRIO.
#   - Valores com ? e @ em senhas de URI devem ser percent-encoded.
# =============================================================================

# -----------------------------------------------------------------------------
# Execução
# -----------------------------------------------------------------------------
# Obrigatório: não. Default: production (compose define).
NODE_ENV=production
# Obrigatório: não. Default: igual a NODE_ENV.
BACKBET_RUNTIME_ENV=production
# Porta HTTP da API (ex.: 3000)
PORT=3000

# -----------------------------------------------------------------------------
# Laboratório — IP de bind das portas publicadas (Mongo/Redis)
# -----------------------------------------------------------------------------
# O IP abaixo é o IP ESTÁTICO e DELIBERADO do laboratório (server01). Não
# altere sem motivo: as portas publicadas 27018/6379 só escutam nesse IP —
# decisão consciente de laboratório, não uma configuração acidental. Em outro
# host, defina LAB_BIND_IP=<ip-do-host> (ex.: 127.0.0.1) ou deixe vazio para
# não publicar porta (Mongo/Redis continuam internos à rede do Compose).
# LAB_BIND_IP=192.168.22.250

# -----------------------------------------------------------------------------
# Infraestrutura
# -----------------------------------------------------------------------------
# Obrigatório: SIM (compose) — aponta para o MongoDB do próprio Compose.
# O host "mongodb" é o serviço interno (rede do Compose); para uso fora do
# Docker, troque pelo host:porta publicado.
# SEGURO de substituir. Formato:
#   mongodb://<usuario>:<senha>@mongodb:27017/<db>?authSource=admin&replicaSet=rs0
MONGODB_URI=mongodb://backbet:e5a4360ac0420f7dce9a6e2bca11f971fb4ca54cd0b521ebfd8537efa75cd16a@mongodb:27017/backbet?authSource=admin&rep>
# Obrigatório: não. Default: backbet.
MONGODB_DB_NAME=backbet
# Usado localmente fora do Docker; no compose o REDIS_URL é redis://redis:6379
REDIS_URL=redis://:505d28862f5faeee97ec5cb63346f6047d1f58cd17c28a81ddc78b1f886f8b1f@redis:6379
# Obrigatório: não. Default: false. True = filas Bull no Redis.
USE_REDIS_QUEUE=true
# Obrigatório: não. Default: true (repositórios Mongoose/Mongo).
REDIS_PASSWORD=505d28862f5faeee97ec5cb63346f6047d1f58cd17c28a81ddc78b1f886f8b1f

USE_MONGOOSE_PERSISTENCE=true

# -----------------------------------------------------------------------------
# Autenticação / segurança
# -----------------------------------------------------------------------------
# Autenticação / segurança
# -----------------------------------------------------------------------------
# Obrigatório: SIM. Gere um valor forte:  openssl rand -hex 32
JWT_SECRET=49a14366dd718e54de738e8d5267a0c466be5ac972950a9143b75df813ad9306
# Issuer/expiração (opcionais)
JWT_ISSUER=backbet
JWT_AUDIENCE=backbet-api
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# Segredos dedicados por tipo de token (recomendado em produção). Se ausentes,
# JWT_SECRET é usado para ambos. Gere:  openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Permite Authorization: Bearer <userId> sem JWT (somente laboratório/dev)
ALLOW_DEV_BEARER_BYPASS=false
# Origens permitidas ao CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Usuários com role admin ou finance (matriz de autorização Fase 9)
ADMIN_USER_IDS=
FINANCE_USER_IDS=

# -----------------------------------------------------------------------------
# E-mail e alertas (SEGREDOS)
# -----------------------------------------------------------------------------
# Worker de contatos (ContactWorker): URL SMTP COMPLETA com credenciais.
# Obrigatório: não (sem valor usa jsonTransport — apenas loga).
# SEGURO de substituir. Formato: smtps://<usuario>:<senha>@<host>:<porta>
MAILER_SMTP_URL=smtps://TROQUE_AQUI_USUARIO:TROQUE_AQUI_SENHA@smtp.example.com:465
# Health monitor (scripts/health-monitor.cjs) — envio de alertas por e-mail:
# Host/porta/credenciais SMTP + remetente. Obrigatório apenas se usar OBS_ENABLE_EMAIL_ALERTS=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=TROQUE_AQUI_USUARIO
SMTP_PASSWORD=TROQUE_AQUI_SENHA
SMTP_FROM=no-reply@example.com

# -----------------------------------------------------------------------------
# Pagamentos / jogos (ambiente de teste no server01)
# -----------------------------------------------------------------------------
# Provedor Pix: 'mock' (sem integração com PSP real)
PIX_PROVIDER=mock
PIX_ENABLE_DEPOSITS=true
PIX_ENABLE_WITHDRAWALS=true
PIX_DEFAULT_KEY=pix@backbet.mock
# CoinFlip desligado no MVP (apostas esportivas de quota fixa)
GAME_COINFLIP_ENABLED=false
# -----------------------------------------------------------------------------
# Integração REAL com provedor de pagamento (FUTURO / PSP autorizado):
# O código hoje lê só PIX_PROVIDER (mock). Ao conectar um PSP, armazene a
# credencial aqui (ou em secret manager) e faça o adaptador lê-la — NUNCA
# comitre o valor real.
# PAYMENT_PROVIDER_KEY=TROQUE_AQUI
# PIX_PROVIDER_KEY=TROQUE_AQUI
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
# Expõe /metrics (Prometheus). Se true, adicione o scrape no Prometheus.
OBS_ENABLE_PROMETHEUS=false
# Traces OpenTelemetry (requer collector — ver docker-compose.observability.yml)
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# Credenciais do collector/remoto (ex.: api-key=...) — SEGREDO, sem valor real aqui
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=backbet-backend

# -----------------------------------------------------------------------------
# Compose (não são injetadas na aplicação, mas usadas pelo docker-compose.yml)
# -----------------------------------------------------------------------------
# Porta publicada pela API no server01 (default 3000). Com o overlay de proxy
# (docker-compose.proxy.yml) ativo, restrinja ao loopback: 127.0.0.1:3000
BACKBET_PORT=3001
# Obrigatório: SIM quando o overlay do proxy estiver ativo
# (docker-compose.proxy.yml). Domínio público resolvido para o server01
# (ex.: api.backbet.example.com) — usado pelo Caddy para emitir o TLS.
PUBLIC_DOMAIN=api.backbet.example.com
# Senha do admin do Grafana (observabilidade) — SEGREDO. Obrigatório se usar
# docker-compose.observability.yml; default inseguro 'admin'.
GF_ADMIN_PASSWORD=TROQUE_AQUI_SENHA_FORTE
# Credenciais da WebUI do PM2 (scripts/pm2-webui-start.cjs). Obrigatório: não;
# default inseguro 'change-me-now'.
PM2_WEB_USERNAME=backbet
PM2_WEB_PASSWORD=TROQUE_AQUI_SENHA_FORTE

# =============================================================================
# BLOCO DO MongoDB 
# =============================================================================
# Usuário administrador raiz do MongoDB
MONGO_ROOT_USER=admin
# Obrigatório: SIM. Senha do usuário raiz (não use caractere '@' sem encode).
MONGO_ROOT_PASSWORD=803611576fd1b143fc0d711c9ef42f0b1c262b7242cc6f21489470cd33720417
# Banco criado no boot do MongoDB
MONGO_INITDB_DATABASE=backbet
# Usuário/senha do app no MongoDB. O serviço `mongodb` do compose roda em
# replica set `rs0` e cria/atualiza estes usuários no primeiro boot do volume
# (deploy/mongo/init-app-user.sh); o `mongo-rs-init` executa o rs.initiate().
MONGODB_APP_USER=backbet
MONGODB_APP_PASSWORD=e5a4360ac0420f7dce9a6e2bca11f971fb4ca54cd0b521ebfd8537efa75cd16a
MONGODB_TEST_DB=backbet-test
MONGODB_TEST_USER=backbet-test
MONGODB_TEST_PASSWORD=803611576fd1b143fc0d711c9ef42f0b1c262b7242cc6f21489470cd33720417
MONGODB_TEST_URI=mongodb://backbet-test:803611576fd1b143fc0d711c9ef42f0b1c262b7242cc6f21489470cd33720417@mongodb:27017/backbet-test?authS>
